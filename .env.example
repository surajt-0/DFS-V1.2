# Copy to .env and fill in for a real deployment. All are optional in dev
# (safe insecure defaults apply) but DFS_SECRET_KEY and DFS_DEBUG=False are
# required before you ever expose this outside your own machine.

DFS_SECRET_KEY=change-me-to-a-long-random-string
DFS_DEBUG=False
DFS_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.example.com
DFS_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# Where uploaded evidence + safe working copies are stored on disk.
DFS_EVIDENCE_ROOT=/var/lib/dfs-suite/evidence_store

# Override the sqlite database location, media root, or static root (all
# default to project-relative paths). Mainly used by desktop_app.py to
# point these at a per-user data directory instead -- see DESKTOP.md.
DFS_DB_PATH=
DFS_MEDIA_ROOT=
DFS_STATIC_ROOT=

# Max upload size in MB (default 512).
DFS_MAX_UPLOAD_MB=512

# Only enable on an investigator's own workstation, never a shared server.
DFS_ENABLE_LOCAL_SCAN=False

# Turn on once you are behind HTTPS.
DFS_SECURE_SSL_REDIRECT=False
DFS_SECURE_COOKIES=False

# Affects server-rendered timestamp display: Django admin's audit log,
# exported CSV/XLSX files, PDF report timestamps. The DB always stores UTC
# regardless (USE_TZ=True) -- this only controls what wall-clock time gets
# shown. Defaults to Asia/Kolkata (IST) if left blank/unset here; use any
# tz database name, e.g. America/New_York, Europe/London, UTC.
DFS_TIME_ZONE=Asia/Kolkata

# Billing / subscriptions (Razorpay). Leave blank to run checkout in demo
# mode (fully functional, but payments are simulated locally instead of
# hitting Razorpay). Get real keys from
# https://dashboard.razorpay.com/app/keys
DFS_RAZORPAY_KEY_ID=
DFS_RAZORPAY_KEY_SECRET=
# Only needed if you configure a webhook in the Razorpay dashboard pointing
# at https://your-domain.example.com/billing/webhook/razorpay/
DFS_RAZORPAY_WEBHOOK_SECRET=

# Paid plans (Pro/Enterprise): may EVERY role -- admin, examiner, read-only
# reviewer -- upload evidence (manually or via the automatic local scan) to
# cases they can see? True by default. Set False to make evidence upload
# require the right to edit the case (viewers can then never upload).
# Editing/deleting cases and removing evidence stay restricted either way.
DFS_EVIDENCE_UPLOAD_ALL_ROLES=True
